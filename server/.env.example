# Copy this file to .env and fill in real values.
# .env should NEVER be committed to git (it's already in .gitignore).

SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string

# Leave as-is for local development (uses a local SQLite file).
# Replace with your Postgres URL when you deploy, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/recipe_swap_hub
DATABASE_URL=sqlite:///app.db
